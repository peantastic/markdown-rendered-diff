{
  "name": "markdown-rendered-diff",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.5.0",
  "preview": true,
  "publisher": "peantastic",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/peantastic/markdown-rendered-diff.git"
  },
  "homepage": "https://github.com/peantastic/markdown-rendered-diff#readme",
  "bugs": {
    "url": "https://github.com/peantastic/markdown-rendered-diff/issues"
  },
  "keywords": [
    "markdown",
    "diff",
    "rendered diff",
    "preview",
    "review",
    "git",
    "table",
    "mermaid",
    "documentation",
    "pull request"
  ],
  "categories": [
    "Visualization",
    "SCM Providers",
    "Other"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "workspaceContains:**/*.md",
    "workspaceContains:**/*.markdown"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%untrusted%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%virtual%"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "mdReview.open",
        "title": "%cmd.open%",
        "category": "%category%",
        "icon": "$(diff)"
      },
      {
        "command": "mdReview.pickBaseline",
        "title": "%cmd.pickBaseline%",
        "category": "%category%",
        "icon": "$(git-compare)"
      },
      {
        "command": "mdReview.refresh",
        "title": "%cmd.refresh%",
        "category": "%category%",
        "icon": "$(refresh)"
      },
      {
        "command": "mdReview.nextFile",
        "title": "%cmd.nextFile%",
        "category": "%category%",
        "icon": "$(arrow-down)"
      },
      {
        "command": "mdReview.prevFile",
        "title": "%cmd.prevFile%",
        "category": "%category%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "mdReview.toggleViewed",
        "title": "%cmd.toggleViewed%",
        "category": "%category%"
      },
      {
        "command": "mdReview.installClaudeHook",
        "title": "%cmd.installClaudeHook%",
        "category": "%category%"
      },
      {
        "command": "mdReview.uninstallClaudeHook",
        "title": "%cmd.uninstallClaudeHook%",
        "category": "%category%"
      },
      {
        "command": "mdReview.openFile",
        "title": "%cmd.openFile%",
        "category": "%category%"
      },
      {
        "command": "mdReview.openCommit",
        "title": "%cmd.openCommit%",
        "category": "%category%"
      },
      {
        "command": "mdReview.viewAsTree",
        "title": "%cmd.viewAsTree%",
        "category": "%category%",
        "icon": "$(list-tree)"
      },
      {
        "command": "mdReview.viewAsList",
        "title": "%cmd.viewAsList%",
        "category": "%category%",
        "icon": "$(list-flat)"
      },
      {
        "command": "mdReview.scrollToSection",
        "title": "%cmd.scrollToSection%",
        "category": "%category%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mdReview",
          "title": "%container%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "mdReview": [
        {
          "id": "mdReview.changes",
          "name": "%view.changes%"
        },
        {
          "id": "mdReview.outline",
          "name": "%view.outline%"
        },
        {
          "id": "mdReview.history",
          "name": "%view.history%"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "mdReview.open",
          "group": "navigation",
          "when": "resourceLangId == markdown || activeCustomEditorId == vscode.markdown.preview.editor || activeWebviewPanelId == markdown.preview"
        }
      ],
      "explorer/context": [
        {
          "command": "mdReview.open",
          "group": "navigation@99",
          "when": "resourceExtname =~ /\\.(md|markdown)$/"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "mdReview.open",
          "group": "inline",
          "when": "resourceExtname =~ /\\.(md|markdown)$/"
        },
        {
          "command": "mdReview.open",
          "group": "navigation",
          "when": "resourceExtname =~ /\\.(md|markdown)$/"
        }
      ],
      "view/title": [
        {
          "command": "mdReview.prevFile",
          "group": "navigation@1",
          "when": "view == mdReview.changes"
        },
        {
          "command": "mdReview.nextFile",
          "group": "navigation@2",
          "when": "view == mdReview.changes"
        },
        {
          "command": "mdReview.pickBaseline",
          "group": "navigation@3",
          "when": "view == mdReview.changes"
        },
        {
          "command": "mdReview.refresh",
          "group": "navigation@4",
          "when": "view == mdReview.changes"
        },
        {
          "command": "mdReview.viewAsTree",
          "group": "navigation@5",
          "when": "view == mdReview.changes && !mdReview.treeMode"
        },
        {
          "command": "mdReview.viewAsList",
          "group": "navigation@5",
          "when": "view == mdReview.changes && mdReview.treeMode"
        }
      ],
      "commandPalette": [
        {
          "command": "mdReview.openFile",
          "when": "false"
        },
        {
          "command": "mdReview.openCommit",
          "when": "false"
        },
        {
          "command": "mdReview.scrollToSection",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mdReview.open",
        "key": "alt+shift+d"
      }
    ],
    "configuration": {
      "title": "%displayName%",
      "properties": {
        "mdReview.defaultBaseline": {
          "type": "string",
          "enum": [
            "head",
            "reviewed",
            "claude",
            "mergeBase",
            "index"
          ],
          "default": "head",
          "description": "%cfg.defaultBaseline%",
          "enumDescriptions": [
            "%cfg.b.head%",
            "%cfg.b.reviewed%",
            "%cfg.b.claude%",
            "%cfg.b.mergeBase%",
            "%cfg.b.index%"
          ]
        },
        "mdReview.mrBaseBranch": {
          "type": "string",
          "default": "",
          "description": "%cfg.mrBaseBranch%",
          "pattern": "^$|^[A-Za-z0-9_./@+~^-]{1,200}$",
          "patternErrorMessage": "%cfg.mrBaseBranch.invalid%"
        },
        "mdReview.renderHtml": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.renderHtml%",
          "scope": "application"
        },
        "mdReview.allowRemoteImages": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.allowRemoteImages%",
          "scope": "application"
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "mdReview.changes",
        "contents": "%welcome.untrusted%",
        "when": "!mdReview.trusted"
      },
      {
        "view": "mdReview.changes",
        "contents": "%welcome.noRepo%",
        "when": "mdReview.trusted && !mdReview.hasRepo"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && vsce package --no-dependencies -o markdown-rendered-diff.vsix",
    "publish:vsce": "vsce publish --no-dependencies --packagePath markdown-rendered-diff.vsix",
    "publish:ovsx": "npx ovsx publish markdown-rendered-diff.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.2",
    "diff": "^9.0.0",
    "dompurify": "3.4.18",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-github-alerts": "^1.0.1",
    "mermaid": "^12.3.0"
  },
  "overrides": {
    "minimatch": "^11.0.9"
  }
}
